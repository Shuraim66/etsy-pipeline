etsy_secrets.json
etsy_token.json

# Pinterest API credentials & OAuth tokens — NEVER commit
pinterest_secrets.json
pinterest_token.json

# Pexels API key & any other secrets — NEVER commit
.pexels_key
*.key
.env
*.env
*_secrets.json
*_token.json
!*.example.json

