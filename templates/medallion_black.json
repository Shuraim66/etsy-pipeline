{
  "name": "medallion_black",
  "_dir": "Ornate geometric rosette: a centralized Islamic geometric medallion with intricate arabesque patterns, black_gold palette variant - authoritative gold on deep black parchment.",
  "canvas": { "w": 3508, "h": 4961 },
  "palette": "black_gold",
  "background": { "from": "bgFrom", "to": "bgTo", "vignette": "palette" },

  "ornament": "medallion",
  "crest": { "size": 320 },
  "border": { "style": "double", "inset": 0.042, "line": 0.0010, "color": "accent" },
  "corner": { "style": "deco", "size": 0.16, "color": "accent" },
  "divider_style": "diamond",

  "fonts": {
    "arabic_name": { "file": "Amiri-Bold.ttf" },
    "arabic_dua":  { "file": "Amiri-Regular.ttf" },
    "latin_name":  { "file": "Cinzel[wght].ttf", "weight": 500 },
    "date":        { "file": "EBGaramond-Italic[wght].ttf", "weight": 500 },
    "body":        { "file": "EBGaramond[wght].ttf", "weight": 450 },
    "translation": { "file": "EBGaramond-Italic[wght].ttf", "weight": 450 }
  },

  "zones": [
    { "region": [0.15, 0.15, 0.70, 0.60], "valign": "center", "blocks": [
      { "id": "arabic_name", "field": "name_arabic", "type": "arabic", "font": "arabic_name", "height": 0.155, "max_w": 0.60, "color": "accent", "gap": 0.000 },
      { "id": "latin_name",  "field": "name_latin",  "type": "line",   "font": "latin_name",  "size": 0.030, "tracking": 0.34, "upper": true, "color": "body", "gap": 0.036 }
    ]},
    { "region": [0.20, 0.75, 0.60, 0.95], "valign": "top", "blocks": [
      { "id": "date",        "type": "line",      "font": "date",        "size": 0.028, "color": "muted", "gap": 0.000 },
      { "id": "divider_1",   "type": "divider",   "style": "diamond", "width": 0.28, "color": "accent", "gap": 0.030 },
      { "id": "meaning",     "type": "paragraph", "font": "body",        "size": 0.0160, "leading": 1.55, "max_w": 0.52, "color": "body", "gap": 0.030 },
      { "id": "dua_arabic",  "type": "arabic",    "font": "arabic_dua",  "height": 0.024, "max_w": 0.48, "color": "accent", "gap": 0.042 },
      { "id": "translation", "field": "dua_translation", "type": "paragraph", "font": "translation", "size": 0.0166, "leading": 1.45, "max_w": 0.42, "color": "muted", "gap": 0.020 }
    ]}
  ]
}