    ]},
    { "region": [0.15, 0.88, 0.85, 0.95], "valign": "center", "blocks": [
      { "id": "meaning",     "type": "paragraph", "font": "body",        "size": 0.0160, "leading": 1.40, "max_w": 0.60, "color": "body", "gap": 0.020 }
