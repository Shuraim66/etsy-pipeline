      { "id": "divider_1",   "type": "divider",   "style": "rule", "width": 0.14, "color": "accent", "gap": 0.030 },
      { "id": "meaning",     "type": "paragraph", "font": "body",        "size": 0.0160, "leading": 1.55, "max_w": 0.66, "color": "body", "gap": 0.030 },
      { "id": "dua_arabic",  "type": "arabic",    "font": "arabic_dua",  "height": 0.024, "max_w": 0.62, "color": "accent", "gap": 0.042 },
      { "id": "translation", "field": "dua_translation", "type": "paragraph", "font": "translation", "size": 0.0166, "leading": 1.45, "max_w": 0.56, "color": "muted", "gap": 0.020 }
    ]}
