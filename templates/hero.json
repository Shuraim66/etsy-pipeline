{
  "name": "hero",
  "_dir": "Calligraphy HERO: the Arabic name is the artwork — oversized and high; small details below. Palette-driven.",
  "canvas": { "w": 3508, "h": 4961 },
  "palette": "emerald_gold",
  "background": { "from": "bgFrom", "to": "bgTo", "vignette": "palette" },

