{
  "name": "backdrop",
  "_dir": "Oversized FADED Arabic name as a background texture; a crisp smaller name + details layered on top. Modern editorial.",
  "canvas": { "w": 3508, "h": 4961 },
  "background": { "from": "#FCFBF8", "to": "#F6F4EE" },
  "colors": { "ink": "#2A2722", "accent": "#9A7B2E", "soft": "#8C857A" },

  "ornament": "none",
  "border": { "style": "none" },
  "watermark": { "field": "name_arabic", "font": "arabic_name", "height": 0.50, "cx": 0.5, "cy": 0.40, "alpha": 0.08, "color": "ink", "max_w": 0.96 },
  "divider_style": "rule",

  "fonts": {
    "arabic_name": { "file": "Amiri-Bold.ttf" },
    "arabic_dua":  { "file": "Amiri-Regular.ttf" },
    "latin_name":  { "file": "Cinzel[wght].ttf", "weight": 600 },
    "date":        { "file": "EBGaramond-Italic[wght].ttf", "weight": 500 },
    "body":        { "file": "EBGaramond[wght].ttf", "weight": 450 },
    "translation": { "file": "EBGaramond-Italic[wght].ttf", "weight": 450 }
  },

  "zones": [
    { "region": [0.12, 0.26, 0.88, 0.92], "valign": "center", "blocks": [
      { "id": "arabic_name", "field": "name_arabic", "type": "arabic", "font": "arabic_name", "height": 0.072, "max_w": 0.50, "color": "ink", "gap": 0.000 },
      { "id": "latin_name",  "field": "name_latin",  "type": "line",   "font": "latin_name",  "size": 0.030, "tracking": 0.22, "upper": true, "color": "accent", "gap": 0.026 },
      { "id": "date",        "type": "line",      "font": "date",        "size": 0.026, "color": "soft", "gap": 0.022 },
      { "id": "divider_1",   "type": "divider",   "style": "rule", "width": 0.14, "color": "accent", "gap": 0.028 },
      { "id": "meaning",     "type": "paragraph", "font": "body",        "size": 0.0162, "leading": 1.55, "max_w": 0.58, "color": "ink", "gap": 0.030 },
      { "id": "dua_arabic",  "type": "arabic",    "font": "arabic_dua",  "height": 0.023, "max_w": 0.56, "color": "ink", "gap": 0.038 },
      { "id": "translation", "field": "dua_translation", "type": "paragraph", "font": "translation", "size": 0.0166, "leading": 1.45, "max_w": 0.50, "color": "soft", "gap": 0.020 }
    ]}
  ]
}
