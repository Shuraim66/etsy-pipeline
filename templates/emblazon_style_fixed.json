{
  "name": "emblazon_style_fixed",
  "_dir": "Architectural heraldic emblazonment: Islamic mihrab arch with decorative linework and coat-of-arms style shields, rendered in authoritative gold with deep parchment background.",
  "canvas": { "w": 3508, "h": 4961 },
  "background": { "from": "bgFrom", "to": "bgTo", "vignette": "palette" },

  "ornament": "arch",
  "arch_big": { "region": [0.25, 0.12, 0.50, 0.58], "color": "accent", "line": 0.0045, "crown": 0.40 },
  "border": { "style": "double", "inset": 0.045, "line": 0.0010, "color": "accent" },
  "corner": { "style": "bracket", "size": 0.14, "color": "accent" },
  "divider_style": "bar",

  "fonts": {
    "arabic_name": { "file": "Amiri-Bold.ttf" },
    "arabic_dua":  { "file": "Amiri-Regular.ttf" },
    "latin_name":  { "file": "Cinzel[wght].ttf", "weight": 600 },
    "date":        { "file": "EBGaramond-Italic[wght].ttf", "weight": 500 },
    "body":        { "file": "EBGaramond[wght].ttf", "weight": 450 },
    "translation": { "file": "EBGaramond-Italic[wght].ttf", "weight": 450 }
  },

  "zones": [
    { "region": [0.30, 0.30, 0.40, 0.50], "valign": "center", "blocks": [
      { "id": "arabic_name", "field": "name_arabic", "type": "arabic", "font": "arabic_name", "height": 0.125, "max_w": 0.42, "color": "accent", "gap": 0.000 },
      { "id": "latin_name",  "field": "name_latin",  "type": "line",   "font": "latin_name",  "size": 0.032, "tracking": 0.28, "upper": true, "color": "body", "gap": 0.034 }
    ]},
    { "region": [0.18, 0.72, 0.64, 0.92], "valign": "top", "blocks": [
      { "id": "date",        "type": "line",      "font": "date",        "size": 0.028, "color": "muted", "gap": 0.000 },
      { "id": "divider_1",   "type": "divider",   "style": "bar", "width": 0.38, "color": "accent", "gap": 0.030 },
      { "id": "meaning",     "type": "paragraph", "font": "body",        "size": 0.0160, "leading": 1.55, "max_w": 0.56, "color": "body", "gap": 0.030 },
      { "id": "dua_arabic",  "type": "arabic",    "font": "arabic_dua",  "height": 0.024, "max_w": 0.50, "color": "accent", "gap": 0.042 },
      { "id": "translation", "field": "dua_translation", "type": "paragraph", "font": "translation", "size": 0.0166, "leading": 1.45, "max_w": 0.44, "color": "muted", "gap": 0.020 }
    ]}
  ]
}