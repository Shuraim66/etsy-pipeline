{
  "name": "sage_block",
  "_dir": "Sage color-block: Rich sage green with cream text, name-forward with geometric accent.",
  "canvas": { "w": 3508, "h": 4961 },
  "background": { "from": "#88B04B", "to": "#5D873F" },
  "colors": { "ink": "#FFFFFF", "accent": "#FFFFFF", "muted": "#F4F1DE" },

  "pattern": {
