    ]},
    { "region": [0.12, 0.45, 0.88, 0.70], "valign": "center", "blocks": [
      { "id": "arabic_name", "field": "name_arabic", "type": "arabic_para", "font": "arabic_name", "size": 0.042, "max_w": 0.72, "color": "accent", "gap": 0.010 }
    ]},
    { "region": [0.25, 0.75, 0.75, 0.82], "valign": "center", "blocks": [
      { "id": "meaning", "type": "line", "font": "latin_name", "size": 0.013, "color": "muted", "gap": 0.0 }
    ]}
  ]
