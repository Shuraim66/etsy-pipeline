    "region": [0.0, 0.0, 1.0, 1.0],
    "cells": 3.5,
    "line": 0.004,
    "color": "ink",
    "alpha": 0.6
  },

  "border": { "style": "double", "inset": 0.036, "gap": 0.008, "line": 0.0010, "color": "ink" },
  "corner": { "style": "none" },
  "divider_style": "diamond",

  "fonts": {
