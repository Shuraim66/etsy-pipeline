{
  "name": "encircled",
  "_dir": "Name encircled by a botanical wreath ring; details stacked below. Nursery/keepsake feel.",
  "canvas": { "w": 3508, "h": 4961 },
  "background": { "from": "#F4EFE3", "to": "#ECE4D2" },
  "colors": { "ink": "#3C4A3A", "sage": "#7B8A63", "gold": "#AD8A39" },

  "ornament": "none",
  "border": { "style": "single", "inset": 0.045, "line": 0.0008, "color": "sage" },
  "corner": { "style": "none" },
  "wreath": { "cx": 0.5, "cy": 0.295, "size": 0.40, "color": "sage" },
  "divider_style": "leaf",

  "fonts": {
    "arabic_name": { "file": "Amiri-Regular.ttf" },
    "arabic_dua":  { "file": "Amiri-Regular.ttf" },
    "latin_name":  { "file": "Cinzel[wght].ttf", "weight": 500 },
    "date":        { "file": "EBGaramond-Italic[wght].ttf", "weight": 500 },
    "body":        { "file": "EBGaramond[wght].ttf", "weight": 450 },
    "translation": { "file": "EBGaramond-Italic[wght].ttf", "weight": 450 }
  },

  "zones": [
    { "region": [0.30, 0.205, 0.70, 0.385], "valign": "center", "blocks": [
      { "id": "arabic_name", "field": "name_arabic", "type": "arabic", "font": "arabic_name", "height": 0.066, "max_w": 0.205, "color": "ink", "gap": 0.000 },
      { "id": "latin_name",  "field": "name_latin",  "type": "line",   "font": "latin_name",  "size": 0.022, "tracking": 0.26, "upper": true, "color": "sage", "gap": 0.020 }
    ]},
    { "region": [0.14, 0.50, 0.86, 0.93], "valign": "top", "blocks": [
      { "id": "date",        "type": "line",      "font": "date",        "size": 0.028, "color": "gold", "gap": 0.000 },
      { "id": "divider_1",   "type": "divider",   "style": "leaf", "width": 0.22, "color": "sage", "gap": 0.030 },
      { "id": "meaning",     "type": "paragraph", "font": "body",        "size": 0.0162, "leading": 1.55, "max_w": 0.62, "color": "ink", "gap": 0.030 },
      { "id": "dua_arabic",  "type": "arabic",    "font": "arabic_dua",  "height": 0.024, "max_w": 0.62, "color": "sage", "gap": 0.038 },
      { "id": "translation", "field": "dua_translation", "type": "paragraph", "font": "translation", "size": 0.0168, "leading": 1.45, "max_w": 0.54, "color": "ink", "gap": 0.020 }
    ]}
