{
  "name": "mihrab",
  "_dir": "Name set inside a large architectural arch; glowing accent linework. Palette-driven.",
  "canvas": { "w": 3508, "h": 4961 },
  "palette": "emerald_gold",
  "background": { "from": "bgFrom", "to": "bgTo", "vignette": "palette" },

  "ornament": "none",
  "border": { "style": "single", "inset": 0.040, "line": 0.0009, "color": "accent" },
