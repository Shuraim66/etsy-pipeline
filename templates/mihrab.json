      { "id": "latin_name",  "field": "name_latin",  "type": "line",   "font": "latin_name",  "size": 0.026, "tracking": 0.24, "upper": true, "color": "body", "gap": 0.026 },
      { "id": "date",        "type": "line",      "font": "date",        "size": 0.026, "color": "muted", "gap": 0.020 }
    ]},
    { "region": [0.16, 0.66, 0.84, 0.93], "valign": "top", "blocks": [
      { "id": "divider_1",   "type": "divider",   "style": "diamond", "width": 0.26, "color": "accent", "gap": 0.000 },
      { "id": "meaning",     "type": "paragraph", "font": "body",        "size": 0.0162, "leading": 1.5, "max_w": 0.62, "color": "body", "gap": 0.030 },
      { "id": "dua_arabic",  "type": "arabic",    "font": "arabic_dua",  "height": 0.024, "max_w": 0.60, "color": "accent", "gap": 0.036 },
      { "id": "translation", "field": "dua_translation", "type": "paragraph", "font": "translation", "size": 0.0166, "leading": 1.4, "max_w": 0.54, "color": "muted", "gap": 0.020 }
    ]}
