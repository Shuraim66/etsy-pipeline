      { "id": "divider_1",   "type": "divider", "style": "diamond", "width": 0.24, "color": "accent", "gap": 0.034 },
      { "id": "meaning",     "type": "paragraph", "font": "body", "size": 0.0162, "leading": 1.5, "max_w": 0.62, "color": "body", "gap": 0.034 }
